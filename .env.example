# Copia questo file in .env.local e compila i valori.

# --- Database ---------------------------------------------------------------
# Vuoto in sviluppo = PGlite locale in .data/pglite (nessun Postgres da installare).
# In produzione: stringa di connessione Neon/Supabase (postgres://...).
DATABASE_URL=

# --- Auth.js ----------------------------------------------------------------
# Genera con: npx auth secret
AUTH_SECRET=
# App su https://dev.twitch.tv/console/apps
# Redirect URL da registrare:
#   http://localhost:3000/api/auth/callback/twitch
#   http://localhost:3000/api/twitch/broadcaster/callback
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=

# --- Twitch -----------------------------------------------------------------
# Id numerico del canale (non lo username).
TWITCH_BROADCASTER_ID=
# Segreto HMAC dei webhook EventSub, 10-100 caratteri casuali.
TWITCH_EVENTSUB_SECRET=
# URL pubblico HTTPS del sito: Twitch invia i webhook a APP_URL/api/webhooks/twitch.
# In locale serve un tunnel (cloudflared, ngrok).
APP_URL=http://localhost:3000

# --- Accesso admin ------------------------------------------------------------
# Id Twitch (numerici) separati da virgola, usati SOLO al primo avvio: `npm run db:migrate`
# li inserisce nella tabella admins, dopodiché gli accessi si gestiscono dal pannello Manager
# e si possono revocare. Lo streamer (TWITCH_BROADCASTER_ID) è sempre admin.
ADMIN_TWITCH_IDS=

# --- Sicurezza ----------------------------------------------------------------
# Vercel Cron invia "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Cifra i token OAuth del broadcaster salvati nel database. 32 byte in base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Storage artwork ------------------------------------------------------------
# local = file in .data/uploads serviti da /media (solo sviluppo)
# s3    = Cloudflare R2 o qualsiasi storage compatibile S3
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pubblico del bucket, senza slash finale (es. https://token.chronos.it)
S3_PUBLIC_URL=

# --- Solo sviluppo ----------------------------------------------------------------
# Mostra /dev-login per entrare come utenti di prova senza Twitch. Ignorato in produzione.
DEV_LOGIN=true
